{
  "entityName": "Task",
  "archetype": "task",
  "description": "Advanced task management with story points, dependencies, approvals, and comprehensive tracking",
  "customFields": [
    {
      "name": "task_code",
      "type": "text",
      "unique": true,
      "regex": "^[A-Z]{2,4}-[0-9]{1,4}$",
      "description": "Unique task identifier (e.g., WEB-123, API-45)"
    },
    {
      "name": "story_points",
      "type": "number",
      "min": 0.5,
      "max": 21,
      "description": "Agile story points for estimation (Fibonacci: 1,2,3,5,8,13,21)"
    },
    {
      "name": "task_type",
      "type": "single-select",
      "required": true,
      "enum": ["feature", "bug", "research", "documentation", "testing", "deployment", "maintenance", "spike"],
      "defaultValue": "feature",
      "description": "Type of work being performed"
    },
    {
      "name": "complexity",
      "type": "single-select",
      "required": true,
      "enum": ["trivial", "minor", "major", "critical"],
      "defaultValue": "minor",
      "description": "Technical complexity assessment"
    },
    {
      "name": "business_value",
      "type": "number",
      "min": 1,
      "max": 100,
      "defaultValue": 50,
      "description": "Business value score (1-100)"
    },
    {
      "name": "effort_level",
      "type": "single-select",
      "required": true,
      "enum": ["xs", "s", "m", "l", "xl", "xxl"],
      "defaultValue": "m",
      "description": "Relative effort size (T-shirt sizing)"
    },
    
    // TIME TRACKING & ESTIMATION
    {
      "name": "estimated_hours",
      "type": "number",
      "min": 0.25,
      "max": 160,
      "description": "Original time estimate in hours"
    },
    {
      "name": "revised_estimated_hours",
      "type": "number",
      "min": 0.25,
      "max": 160,
      "description": "Revised estimate based on learning"
    },
    {
      "name": "current_estimate",
      "type": "computed_expression",
      "expression": "revised_estimated_hours || estimated_hours",
      "dependencies": ["revised_estimated_hours", "estimated_hours"],
      "description": "Current best estimate (revised or original)"
    },
    {
      "name": "actual_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "logged_for",
        "targetEntityType": "Timesheet",
        "targetField": "hours_logged"
      },
      "description": "Total hours logged against this task"
    },
    {
      "name": "remaining_hours",
      "type": "number",
      "min": 0,
      "description": "Estimated hours remaining (manual input by assignee)"
    },
    {
      "name": "time_variance",
      "type": "computed_expression",
      "expression": "current_estimate > 0 ? ((actual_hours - current_estimate) / current_estimate) * 100 : 0",
      "dependencies": ["actual_hours", "current_estimate"],
      "description": "Time variance percentage (positive = over estimate)"
    },
    {
      "name": "completion_efficiency",
      "type": "computed_expression",
      "expression": "actual_hours > 0 ? current_estimate / actual_hours : 1",
      "dependencies": ["current_estimate", "actual_hours"],
      "description": "Efficiency ratio (>1 = under estimate, <1 = over estimate)"
    },
    {
      "name": "estimated_cost",
      "type": "computed_expression",
      "expression": "current_estimate * 100", 
      "dependencies": ["current_estimate"],
      "description": "Estimated cost at $100/hour"
    },
    {
      "name": "actual_cost",
      "type": "computed_expression",
      "expression": "actual_hours * 100",
      "dependencies": ["actual_hours"],
      "description": "Actual cost at $100/hour"
    },
    
    // PROGRESS & STATUS TRACKING
    {
      "name": "progress_percentage",
      "type": "number",
      "min": 0,
      "max": 100,
      "defaultValue": 0,
      "description": "Task completion percentage (0-100)"
    },
    {
      "name": "last_updated_date",
      "type": "date",
      "description": "Date task was last updated"
    },
    {
      "name": "days_since_update",
      "type": "computed_expression",
      "expression": "last_updated_date ? ($today - last_updated_date) : ($today - created_at)",
      "dependencies": ["last_updated_date"],
      "description": "Days since last update"
    },
    {
      "name": "is_overdue",
      "type": "computed_expression",
      "expression": "due_date && $today > due_date && status != 'done'",
      "dependencies": ["due_date"],
      "description": "Whether task is past due date"
    },
    {
      "name": "days_until_due",
      "type": "computed_expression",
      "expression": "due_date ? (due_date - $today) : null",
      "dependencies": ["due_date"],
      "description": "Days until due date (negative if overdue)"
    },
    
    // BLOCKING & DEPENDENCIES
    {
      "name": "is_blocked",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether task is currently blocked"
    },
    {
      "name": "blocked_reason",
      "type": "rich-text",
      "description": "Detailed reason for blocking"
    },
    {
      "name": "blocked_since",
      "type": "date",
      "description": "Date task was blocked"
    },
    {
      "name": "days_blocked",
      "type": "computed_expression",
      "expression": "blocked_since ? ($today - blocked_since) : 0",
      "dependencies": ["blocked_since"],
      "description": "Number of days task has been blocked"
    },
    {
      "name": "blocking_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "depends_on",
        "targetEntityType": "Task"
      },
      "description": "Number of tasks this task depends on"
    },
    {
      "name": "dependent_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "blocks",
        "targetEntityType": "Task"
      },
      "description": "Number of tasks that depend on this task"
    },
    {
      "name": "unresolved_dependencies",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "depends_on",
        "targetEntityType": "Task",
        "conditions": {"status": "!done"}
      },
      "description": "Number of incomplete tasks this depends on"
    },
    {
      "name": "ready_to_start",
      "type": "computed_expression",
      "expression": "unresolved_dependencies == 0 && !is_blocked",
      "dependencies": ["unresolved_dependencies", "is_blocked"],
      "description": "Whether task is ready to begin work"
    },
    
    // QUALITY & TESTING
    {
      "name": "testing_required",
      "type": "boolean",
      "defaultValue": true,
      "description": "Whether task requires testing"
    },
    {
      "name": "code_review_required",
      "type": "boolean",
      "defaultValue": true,
      "description": "Whether code review is required"
    },
    {
      "name": "security_review_required",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether security review is required"
    },
    {
      "name": "test_coverage",
      "type": "number",
      "min": 0,
      "max": 100,
      "description": "Test coverage percentage"
    },
    {
      "name": "code_review_status",
      "type": "single-select",
      "enum": ["not_required", "pending", "in_review", "changes_requested", "approved"],
      "defaultValue": "not_required",
      "description": "Status of code review process"
    },
    {
      "name": "testing_status",
      "type": "single-select",
      "enum": ["not_required", "pending", "in_progress", "failed", "passed"],
      "defaultValue": "not_required",
      "description": "Status of testing process"
    },
    {
      "name": "quality_gate_passed",
      "type": "computed_expression",
      "expression": "(code_review_required ? code_review_status == 'approved' : true) && (testing_required ? testing_status == 'passed' : true)",
      "dependencies": ["code_review_required", "code_review_status", "testing_required", "testing_status"],
      "description": "Whether all quality gates have been passed"
    },
    
    // ACCEPTANCE CRITERIA & DEFINITION OF DONE
    {
      "name": "acceptance_criteria_count",
      "type": "number",
      "min": 0,
      "defaultValue": 0,
      "description": "Number of acceptance criteria defined"
    },
    {
      "name": "acceptance_criteria_met",
      "type": "number",
      "min": 0,
      "defaultValue": 0,
      "description": "Number of acceptance criteria completed"
    },
    {
      "name": "acceptance_criteria_completion_rate",
      "type": "computed_expression",
      "expression": "acceptance_criteria_count > 0 ? (acceptance_criteria_met / acceptance_criteria_count) * 100 : 100",
      "dependencies": ["acceptance_criteria_met", "acceptance_criteria_count"],
      "description": "Percentage of acceptance criteria completed"
    },
    {
      "name": "definition_of_done_met",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether definition of done has been satisfied"
    },
    {
      "name": "ready_for_completion",
      "type": "computed_expression",
      "expression": "quality_gate_passed && acceptance_criteria_completion_rate >= 100 && definition_of_done_met",
      "dependencies": ["quality_gate_passed", "acceptance_criteria_completion_rate", "definition_of_done_met"],
      "description": "Whether task meets all completion criteria"
    },
    
    // RISK & ESCALATION
    {
      "name": "risk_level",
      "type": "single-select",
      "enum": ["low", "medium", "high", "critical"],
      "defaultValue": "low",
      "description": "Risk assessment for task completion"
    },
    {
      "name": "escalation_required",
      "type": "computed_expression",
      "expression": "is_overdue || days_blocked > 3 || risk_level == 'critical'",
      "dependencies": ["is_overdue", "days_blocked", "risk_level"],
      "description": "Whether task requires management escalation"
    },
    {
      "name": "escalation_reason",
      "type": "computed_formula",
      "expression": "is_overdue ? 'Overdue task' : (days_blocked > 3 ? 'Blocked too long' : (risk_level == 'critical' ? 'Critical risk' : 'No escalation'))",
      "dependencies": ["is_overdue", "days_blocked", "risk_level"],
      "resultType": "text",
      "computeLocation": "backend",
      "description": "Primary reason for escalation"
    },
    
    // TASK HEALTH METRICS
    {
      "name": "task_health_score",
      "type": "computed_formula",
      "expression": "((progress_percentage * 0.3) + ((time_variance < 20 ? 100 : (time_variance < 50 ? 70 : 40)) * 0.25) + (quality_gate_passed ? 100 : 0) * 0.25 + (ready_to_start ? 100 : 50) * 0.2) * (is_blocked ? 0.5 : 1)",
      "dependencies": ["progress_percentage", "time_variance", "quality_gate_passed", "ready_to_start", "is_blocked"],
      "resultType": "number",
      "computeLocation": "backend",
      "cacheResults": true,
      "description": "Overall task health score (0-100)"
    },
    {
      "name": "schedule_confidence",
      "type": "computed_expression",
      "expression": "due_date && current_estimate ? (remaining_hours <= (days_until_due * 8) ? 100 : 50) : 80",
      "dependencies": ["due_date", "current_estimate", "remaining_hours", "days_until_due"],
      "description": "Confidence in meeting scheduled completion"
    },
    
    // RELATIONSHIP FIELDS - Task Assignment & Hierarchy
    {
      "name": "assignee_id",
      "type": "custom_user_reference",
      "relationshipType": "assigned_to",
      "description": "Primary person responsible for completing task"
    },
    {
      "name": "reviewer_id",
      "type": "custom_user_reference",
      "relationshipType": "reviewed_by",
      "description": "Person responsible for code/quality review"
    },
    {
      "name": "tester_id",
      "type": "custom_user_reference",
      "relationshipType": "tested_by",
      "description": "Person responsible for testing the task"
    },
    {
      "name": "reporter_id",
      "type": "custom_user_reference",
      "relationshipType": "reported_by",
      "description": "Person who created/reported the task"
    },
    {
      "name": "project_id",
      "type": "custom_entity_reference",
      "relationshipType": "belongs_to",
      "targetEntityType": "Project",
      "required": true,
      "description": "Project this task belongs to"
    },
    {
      "name": "epic_id",
      "type": "custom_entity_reference",
      "relationshipType": "belongs_to",
      "targetEntityType": "Epic",
      "description": "Epic this task belongs to"
    },
    {
      "name": "parent_task_id",
      "type": "custom_entity_reference",
      "relationshipType": "subtask_of",
      "targetEntityType": "Task",
      "description": "Parent task if this is a subtask"
    },
    {
      "name": "sprint_id",
      "type": "custom_entity_reference",
      "relationshipType": "planned_for",
      "targetEntityType": "Sprint",
      "description": "Sprint this task is planned for"
    },
    {
      "name": "client_id",
      "type": "custom_entity_reference",
      "relationshipType": "requested_by",
      "targetEntityType": "Client",
      "description": "Client who requested this task"
    }
  ],
  
  "businessRules": {
    "validation": [
      "estimated_hours must be provided if story_points is provided",
      "due_date must be after start_date if both are provided",
      "remaining_hours cannot be greater than current_estimate",
      "acceptance_criteria_met cannot exceed acceptance_criteria_count",
      "progress_percentage should align with acceptance_criteria_completion_rate",
      "assignee_id cannot be the same as reviewer_id for quality assurance"
    ],
    "workflows": [
      {
        "name": "task_approval",
        "trigger": "field_change",
        "field": "status",
        "condition": "new_value == 'done'",
        "approvers": ["reviewer_id"],
        "requiredConditions": ["ready_for_completion == true"],
        "description": "Approval required before marking task as done"
      },
      {
        "name": "scope_change_approval",
        "trigger": "field_change",
        "field": "estimated_hours",
        "condition": "new_value > old_value * 1.5",
        "approvers": ["project.project_manager_id"],
        "description": "Project manager approval for 50%+ scope increases"
      },
      {
        "name": "high_risk_escalation",
        "trigger": "field_change",
        "field": "risk_level",
        "condition": "new_value == 'critical'",
        "approvers": ["project.sponsor_id"],
        "description": "Executive approval for critical risk tasks"
      },
      {
        "name": "unblock_approval",
        "trigger": "field_change",
        "field": "is_blocked",
        "condition": "old_value == true && new_value == false",
        "approvers": ["assignee_id"],
        "description": "Assignee confirmation that blocking issue is resolved"
      }
    ],
    "dependencies": [
      {
        "name": "task_sequencing",
        "dependencyType": "finish_to_start",
        "description": "Tasks can depend on completion of other tasks"
      },
      {
        "name": "parallel_tasks",
        "dependencyType": "start_to_start", 
        "description": "Tasks that must start together"
      },
      {
        "name": "synchronized_completion",
        "dependencyType": "finish_to_finish",
        "description": "Tasks that must finish together"
      }
    ],
    "automations": [
      {
        "name": "auto_block_on_dependencies",
        "trigger": "dependency_change",
        "action": "set_field",
        "field": "is_blocked",
        "value": true,
        "condition": "unresolved_dependencies > 0",
        "description": "Automatically block task when dependencies are incomplete"
      },
      {
        "name": "auto_ready_on_dependencies_complete",
        "trigger": "dependency_change",
        "action": "set_field",
        "field": "is_blocked", 
        "value": false,
        "condition": "unresolved_dependencies == 0 && blocked_reason contains 'dependency'",
        "description": "Auto-unblock when all dependencies are complete"
      }
    ]
  }
}