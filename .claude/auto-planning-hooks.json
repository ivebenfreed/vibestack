{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/claude-prompter.sh Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/claude-prompter.sh UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/session-start.sh"
          },
          {
            "type": "command",
            "command": "echo '{\"additionalContext\": \"📋 Session started. Consider creating or updating the session plan with goals and expected deliverables.\"}'",
            "timeout": 3
          }
        ]
      }
    ]
  }
}