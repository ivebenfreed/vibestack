# Universal Reactive Data Pattern (Atomic Edition)

## Core Concept

The Universal Reactive Data Pattern (Atomic Edition) uses Jotai atomic stores for **surgical precision** updates. Each entity gets its own atom, enabling only specific components to re-render when that entity changes.

## Key Principles

### 1. Surgical Updates
- Individual entity atoms update independently
- Only components reading specific entities re-render
- Collections derive from individual atoms automatically

### 2. Instant Loading
- Router loaders pre-populate atomic stores during navigation
- Users see content immediately when pages load

### 3. Co-located Atomic Stores
- Atomic stores live with domain services
- Direct integration with business logic

## Architecture

```
┌─────────────────┐    ┌──────────────────┐    ┌─────────────────┐
│  Router Loaders │───▶│ Individual Atoms │───▶│   Live Queries  │
│  (Bulk Loading) │    │ (Surgical Store) │    │ (Surgical Updt) │
└─────────────────┘    └──────────────────┘    └─────────────────┘
```

## ✅ DO: Individual Entity Atoms

```typescript
// ✅ Each entity gets its own atom
const TaskAtomStore = {
  getTaskAtom: (id: string) => {
    if (!globalTaskAtoms.has(id)) {
      globalTaskAtoms.set(id, atom<Task | null>(null))
    }
    return globalTaskAtoms.get(id)!
  },
  
  // ✅ Derived collection from individual atoms
  allTasksAtom: atom<Task[]>((get) => {
    const atomValues = Array.from(globalTaskAtoms.values())
    return atomValues
      .map(taskAtom => get(taskAtom))
      .filter(task => task !== null)
  })
}
```

## ✅ DO: Co-locate with Domain Services

```typescript
// ✅ Atomic store lives with domain service
export class TaskService extends BaseService<Task> {
  static atoms: TaskAtomStore;
  
  async updateTask(id: string, changes: Partial<Task>): Promise<Task> {
    const updatedTask = await this.repository.update(id, changes)
    
    // ✅ Surgical update: only this task's atom changes
    const taskAtom = TaskService.atoms.getTaskAtom(id)
    const store = getDefaultStore()
    store.set(taskAtom, updatedTask)
    
    return updatedTask
  }
}
```

## ✅ DO: Router Loaders Bulk Populate

```typescript
// ✅ Router loaders populate individual atoms efficiently
export const Route = createFileRoute('/_authenticated/tasks/')({
  loader: async () => {
    const store = getDefaultStore()
    const existingTasks = store.get(TaskService.atoms.allTasksAtom)
    
    if (existingTasks.length > 0) return null // Already populated
    
    const dataSource = await getNewPGliteDataSource()
    const tasks = await dataSource.getRepository(Task).find()
    
    // ✅ Bulk load into individual atoms
    store.set(TaskService.atoms.syncBulkLoad, tasks)
    return null
  },
  component: Tasks,
})
```

## ✅ DO: Surgical Component Updates

```typescript
// ✅ Pass IDs, not entire objects - enables surgical updates
const TaskList = () => {
  const tasks = useAtomValue(TaskService.atoms.allTasksAtom)
  return (
    <div>
      {tasks.map(task => (
        <TaskCard key={task.id} taskId={task.id} />
      ))}
    </div>
  )
}

// ✅ Component reads individual atom - only re-renders when THIS task changes
const TaskCard = ({ taskId }: { taskId: string }) => {
  const task = useAtomValue(TaskService.atoms.getTaskAtom(taskId))
  if (!task) return null
  return <Card>{task.title}</Card>
}
```

## ✅ DO: CRUD with Surgical Updates

```typescript
// ✅ Create - adds new individual atom
const useCreateTask = () => {
  return useMutation({
    mutationFn: async (taskData: CreateTaskData) => {
      const newTask = await services.tasks.createTask(taskData)
      
      // ✅ Only new atom is created
      const store = getDefaultStore()
      const taskAtom = TaskService.atoms.getTaskAtom(newTask.id)
      store.set(taskAtom, newTask)
      
      return newTask
    }
  })
}

// ✅ Update - updates specific individual atom
const useUpdateTask = () => {
  return useMutation({
    mutationFn: async ({ id, changes }) => {
      const updatedTask = await services.tasks.updateTask(id, changes)
      
      // ✅ Only this task's atom updates
      const store = getDefaultStore()
      const taskAtom = TaskService.atoms.getTaskAtom(id)
      store.set(taskAtom, updatedTask)
      
      return updatedTask
    }
  })
}

// ✅ Delete - nullifies specific individual atom
const useDeleteTask = () => {
  return useMutation({
    mutationFn: async (id: string) => {
      await services.tasks.deleteTask(id)
      
      // ✅ Only this task's atom is nullified
      const store = getDefaultStore()
      const taskAtom = TaskService.atoms.getTaskAtom(id)
      store.set(taskAtom, null)
      
      return id
    }
  })
}
```

## ❌ DON'T: Bulk State Updates

```typescript
// ❌ DON'T do this - causes bulk re-renders
const [tasks, setTasks] = useState([])
const updateTask = (updatedTask) => {
  setTasks(prev => prev.map(t => t.id === updatedTask.id ? updatedTask : t))
  // All TaskCard components re-render unnecessarily
}

// ❌ DON'T invalidate entire cache
queryClient.invalidateQueries(['tasks']) // Refetches all data

// ❌ DON'T pass entire objects as props
<TaskCard task={task} /> // Prevents surgical updates

// ❌ DON'T use manual state management
const [loading, setLoading] = useState(true)
const [data, setData] = useState([])
```

## Live Query Integration

```typescript
// ✅ Live queries update individual atoms surgically
class TaskAtomStore {
  private processLiveChanges(changes: TaskChange[]) {
    const store = getDefaultStore()
    
    changes.forEach(change => {
      const task = this.transformDatabaseResult(change)
      const taskAtom = this.getTaskAtom(task.id)
      
      switch (change.__op__) {
        case 'INSERT':
        case 'UPDATE':
          store.set(taskAtom, task) // ✅ Only this atom updates
          break
        case 'DELETE':
          store.set(taskAtom, null) // ✅ Only this atom nullifies
          break
      }
    })
  }
}
```

## Jotai Setup

```typescript
// main.tsx
import { Provider, getDefaultStore } from 'jotai'

function App() {
  return (
    <Provider store={getDefaultStore()}>
      <RouterProvider router={router} />
    </Provider>
  )
}
```

## Key Benefits

1. **Surgical Updates**: Only changed entities trigger re-renders
2. **Instant Loading**: Router loaders pre-populate atomic stores
3. **Real-time Sync**: Live queries update individual atoms
4. **Performance**: Minimal re-renders and efficient memory usage

## Common Patterns

### Filtered Collections
```typescript
// ✅ Efficient filtering from atomic store
function useTasksByProject(projectId: string) {
  const allTasks = useAtomValue(TaskService.atoms.allTasksAtom)
  
  const projectTasks = useMemo(() => {
    return allTasks.filter(task => task.projectId === projectId)
  }, [allTasks, projectId])
  
  return { data: projectTasks, isLoading: false, error: null }
}
```

### Relationship Loading
```typescript
// ✅ Individual atoms for relationships
const ProjectDetail = ({ projectId }: { projectId: string }) => {
  const project = useAtomValue(ProjectService.atoms.getProjectAtom(projectId))
  const projectTasks = useTasksByProject(projectId)
  
  return (
    <div>
      <h1>{project?.name}</h1>
      <TaskList tasks={projectTasks.data} />
    </div>
  )
}
```
