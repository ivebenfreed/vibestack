FROM postgres:17

# Install build dependencies and wal2json
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    postgresql-server-dev-17 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Clone and build wal2json
RUN git clone https://github.com/eulerto/wal2json.git /tmp/wal2json && \
    cd /tmp/wal2json && \
    make && \
    make install && \
    rm -rf /tmp/wal2json

# Add wal2json to shared_preload_libraries
RUN echo "shared_preload_libraries = 'wal2json'" >> /usr/share/postgresql/postgresql.conf.sample