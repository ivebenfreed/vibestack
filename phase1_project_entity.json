{
  "entityName": "Project",
  "archetype": "project",
  "description": "Enhanced project management with financial tracking, resource management, and quality gates",
  "customFields": [
    {
      "name": "project_code",
      "type": "text",
      "required": true,
      "unique": true,
      "regex": "^[A-Z]{2,3}-[0-9]{3,4}$",
      "description": "Unique project identifier (e.g., DX-2025, WEB-456)"
    },
    {
      "name": "complexity_score",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 10,
      "defaultValue": 5,
      "description": "Project complexity rating (1=simple, 10=highly complex)"
    },
    {
      "name": "risk_level",
      "type": "single-select",
      "required": true,
      "enum": ["low", "medium", "high", "critical"],
      "defaultValue": "medium",
      "description": "Overall project risk assessment"
    },
    {
      "name": "methodology",
      "type": "single-select",
      "required": true,
      "enum": ["agile", "waterfall", "hybrid", "lean", "kanban", "scrumban"],
      "defaultValue": "agile",
      "description": "Project management methodology"
    },
    {
      "name": "project_type",
      "type": "single-select",
      "required": true,
      "enum": ["software_development", "infrastructure", "research", "marketing", "operational", "strategic", "compliance"],
      "defaultValue": "software_development",
      "description": "Type of project work"
    },
    {
      "name": "client_facing",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether project directly impacts external clients"
    },
    
    // ENHANCED FINANCIAL TRACKING
    {
      "name": "approved_budget",
      "type": "currency",
      "required": true,
      "min": 1000,
      "description": "Board-approved project budget"
    },
    {
      "name": "contingency_percent",
      "type": "number",
      "min": 0,
      "max": 50,
      "defaultValue": 10,
      "description": "Budget contingency percentage"
    },
    {
      "name": "total_budget_with_contingency",
      "type": "computed_expression",
      "expression": "approved_budget * (1 + contingency_percent / 100)",
      "dependencies": ["approved_budget", "contingency_percent"],
      "description": "Budget including contingency"
    },
    {
      "name": "spent_budget",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "charged_to",
        "targetEntityType": "Expense",
        "targetField": "amount"
      },
      "description": "Total expenses charged to project"
    },
    {
      "name": "committed_budget",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "estimated_cost"
      },
      "description": "Budget committed to planned tasks"
    },
    {
      "name": "budget_utilization_percent",
      "type": "computed_expression",
      "expression": "(spent_budget / approved_budget) * 100",
      "dependencies": ["spent_budget", "approved_budget"],
      "description": "Percentage of approved budget spent"
    },
    {
      "name": "budget_commitment_percent",
      "type": "computed_expression",
      "expression": "((spent_budget + committed_budget) / approved_budget) * 100",
      "dependencies": ["spent_budget", "committed_budget", "approved_budget"],
      "description": "Percentage of budget spent + committed"
    },
    {
      "name": "remaining_budget",
      "type": "computed_expression",
      "expression": "approved_budget - spent_budget",
      "dependencies": ["approved_budget", "spent_budget"],
      "description": "Available budget remaining"
    },
    {
      "name": "projected_final_cost",
      "type": "computed_formula",
      "expression": "progress_percentage > 0 ? (spent_budget / (progress_percentage / 100)) : approved_budget",
      "dependencies": ["spent_budget", "progress_percentage", "approved_budget"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Projected total cost at completion"
    },
    {
      "name": "budget_variance",
      "type": "computed_expression",
      "expression": "projected_final_cost - approved_budget",
      "dependencies": ["projected_final_cost", "approved_budget"],
      "description": "Projected budget variance (positive = over budget)"
    },
    {
      "name": "budget_variance_percent",
      "type": "computed_expression",
      "expression": "approved_budget > 0 ? (budget_variance / approved_budget) * 100 : 0",
      "dependencies": ["budget_variance", "approved_budget"],
      "description": "Budget variance as percentage"
    },
    
    // RESOURCE & TIME MANAGEMENT
    {
      "name": "allocated_hours",
      "type": "number",
      "required": true,
      "min": 8,
      "description": "Total allocated project hours"
    },
    {
      "name": "actual_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "worked_on",
        "targetEntityType": "Timesheet",
        "targetField": "hours_logged"
      },
      "description": "Total hours logged against project"
    },
    {
      "name": "billable_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "worked_on",
        "targetEntityType": "Timesheet",
        "targetField": "hours_logged",
        "conditions": {"billable": true}
      },
      "description": "Total billable hours logged"
    },
    {
      "name": "team_size",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "assigned_to",
        "targetEntityType": "User"
      },
      "description": "Number of team members assigned"
    },
    {
      "name": "hours_utilization_percent",
      "type": "computed_expression",
      "expression": "(actual_hours / allocated_hours) * 100",
      "dependencies": ["actual_hours", "allocated_hours"],
      "description": "Percentage of allocated hours used"
    },
    {
      "name": "completion_velocity",
      "type": "computed_expression",
      "expression": "actual_hours > 0 ? progress_percentage / actual_hours : 0",
      "dependencies": ["progress_percentage", "actual_hours"],
      "description": "Progress percentage per hour worked"
    },
    {
      "name": "projected_total_hours",
      "type": "computed_formula",
      "expression": "progress_percentage > 0 ? (actual_hours / (progress_percentage / 100)) : allocated_hours",
      "dependencies": ["actual_hours", "progress_percentage", "allocated_hours"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Projected total hours at completion"
    },
    {
      "name": "hours_variance",
      "type": "computed_expression",
      "expression": "projected_total_hours - allocated_hours",
      "dependencies": ["projected_total_hours", "allocated_hours"],
      "description": "Projected hours variance (positive = over estimate)"
    },
    
    // QUALITY & DELIVERABLES TRACKING
    {
      "name": "quality_gate_passed",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether project has passed quality gate review"
    },
    {
      "name": "code_review_required",
      "type": "boolean",
      "defaultValue": true,
      "description": "Whether code reviews are required for this project"
    },
    {
      "name": "security_review_required",
      "type": "boolean",
      "defaultValue": false,
      "description": "Whether security review is required"
    },
    {
      "name": "deliverable_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "File",
        "conditions": {"file_type": "deliverable"}
      },
      "description": "Number of project deliverables"
    },
    {
      "name": "approved_deliverable_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "File",
        "conditions": {"file_type": "deliverable", "status": "approved"}
      },
      "description": "Number of approved deliverables"
    },
    {
      "name": "deliverable_approval_rate",
      "type": "computed_expression",
      "expression": "deliverable_count > 0 ? (approved_deliverable_count / deliverable_count) * 100 : 100",
      "dependencies": ["approved_deliverable_count", "deliverable_count"],
      "description": "Percentage of deliverables approved"
    },
    
    // TASK & ISSUE MANAGEMENT
    {
      "name": "total_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task"
      },
      "description": "Total number of tasks in project"
    },
    {
      "name": "completed_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "done"}
      },
      "description": "Number of completed tasks"
    },
    {
      "name": "active_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "active"}
      },
      "description": "Number of active tasks"
    },
    {
      "name": "blocked_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "blocked"}
      },
      "description": "Number of blocked tasks"
    },
    {
      "name": "high_priority_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"priority": "high"}
      },
      "description": "Number of high-priority tasks"
    },
    {
      "name": "task_completion_rate",
      "type": "computed_expression",
      "expression": "total_task_count > 0 ? (completed_task_count / total_task_count) * 100 : 0",
      "dependencies": ["completed_task_count", "total_task_count"],
      "description": "Percentage of tasks completed"
    },
    {
      "name": "total_story_points",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "story_points"
      },
      "description": "Total story points in project"
    },
    {
      "name": "completed_story_points",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "story_points",
        "conditions": {"status": "done"}
      },
      "description": "Story points completed"
    },
    {
      "name": "story_points_completion_rate",
      "type": "computed_expression",
      "expression": "total_story_points > 0 ? (completed_story_points / total_story_points) * 100 : 0",
      "dependencies": ["completed_story_points", "total_story_points"],
      "description": "Percentage of story points completed"
    },
    
    // HEALTH & PERFORMANCE METRICS
    {
      "name": "project_health_score",
      "type": "computed_formula",
      "expression": "((progress_percentage * 0.3) + (task_completion_rate * 0.2) + ((100 - budget_utilization_percent) * 0.2) + (deliverable_approval_rate * 0.15) + ((team_size > 0 ? 100 : 0) * 0.15)) * (blocked_task_count == 0 ? 1 : 0.8)",
      "dependencies": ["progress_percentage", "task_completion_rate", "budget_utilization_percent", "deliverable_approval_rate", "team_size", "blocked_task_count"],
      "resultType": "number",
      "computeLocation": "backend",
      "cacheResults": true,
      "description": "Overall project health score (0-100)"
    },
    {
      "name": "schedule_performance_index",
      "type": "computed_formula",
      "expression": "start_date && end_date ? (progress_percentage / (($today - start_date) / (end_date - start_date) * 100)) : 1",
      "dependencies": ["progress_percentage", "start_date", "end_date"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Schedule Performance Index (SPI)"
    },
    {
      "name": "cost_performance_index",
      "type": "computed_expression",
      "expression": "spent_budget > 0 ? ((progress_percentage / 100) * approved_budget) / spent_budget : 1",
      "dependencies": ["progress_percentage", "approved_budget", "spent_budget"],
      "description": "Cost Performance Index (CPI)"
    },
    
    // RELATIONSHIP FIELDS - Project Structure
    {
      "name": "portfolio_id",
      "type": "custom_entity_reference",
      "relationshipType": "belongs_to",
      "targetEntityType": "Portfolio",
      "description": "Portfolio this project belongs to"
    },
    {
      "name": "project_manager_id",
      "type": "custom_user_reference",
      "relationshipType": "managed_by",
      "required": true,
      "description": "Primary project manager"
    },
    {
      "name": "technical_lead_id",
      "type": "custom_user_reference",
      "relationshipType": "technical_lead",
      "description": "Technical lead for the project"
    },
    {
      "name": "product_owner_id",
      "type": "custom_user_reference",
      "relationshipType": "owned_by",
      "description": "Product owner defining requirements"
    },
    {
      "name": "client_id",
      "type": "custom_entity_reference",
      "relationshipType": "delivered_to",
      "targetEntityType": "Client",
      "description": "Client receiving project deliverables"
    },
    {
      "name": "parent_project_id",
      "type": "custom_entity_reference",
      "relationshipType": "child_of",
      "targetEntityType": "Project",
      "description": "Parent project if this is a subproject"
    },
    {
      "name": "sponsor_id",
      "type": "custom_user_reference",
      "relationshipType": "sponsored_by",
      "required": true,
      "description": "Executive sponsor providing business support"
    },
    {
      "name": "budget_approver_id",
      "type": "custom_user_reference",
      "relationshipType": "budget_approved_by",
      "description": "Authority for budget approvals"
    }
  ],
  
  "businessRules": {
    "validation": [
      "start_date must be before end_date",
      "approved_budget must be greater than 0",
      "complexity_score must align with allocated_hours (complex projects need more hours)",
      "project_manager_id cannot be the same as sponsor_id",
      "end_date must be in the future for active projects"
    ],
    "workflows": [
      {
        "name": "project_initiation_approval",
        "trigger": "entity_create",
        "approvers": ["sponsor_id", "budget_approver_id"],
        "sequence": "sequential",
        "description": "Approval required to start new project"
      },
      {
        "name": "budget_increase_approval",
        "trigger": "field_change",
        "field": "approved_budget",
        "condition": "new_value > old_value * 1.1",
        "approvers": ["budget_approver_id", "sponsor_id"],
        "sequence": "parallel",
        "description": "Approval for budget increases >10%"
      },
      {
        "name": "scope_change_approval",
        "trigger": "field_change",
        "field": "allocated_hours",
        "condition": "new_value > old_value * 1.2",
        "approvers": ["project_manager_id", "sponsor_id"],
        "sequence": "sequential",
        "description": "Approval for scope increases >20%"
      },
      {
        "name": "project_closure_approval",
        "trigger": "field_change",
        "field": "status",
        "condition": "new_value == 'completed'",
        "approvers": ["sponsor_id"],
        "description": "Sign-off required to close project"
      }
    ],
    "dependencies": [
      {
        "name": "project_sequencing",
        "dependencyType": "finish_to_start",
        "description": "Projects can depend on completion of other projects"
      },
      {
        "name": "resource_dependencies",
        "dependencyType": "start_to_start",
        "description": "Projects sharing resources may need coordinated starts"
      }
    ]
  }
}