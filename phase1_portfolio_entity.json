{
  "entityName": "Portfolio",
  "archetype": "collection",
  "description": "Strategic portfolio management with advanced analytics and computed health metrics",
  "customFields": [
    {
      "name": "portfolio_code",
      "type": "text",
      "required": true,
      "unique": true,
      "regex": "^[A-Z]{2,4}-[0-9]{4}$",
      "description": "Unique portfolio identifier (e.g., DX-2025)"
    },
    {
      "name": "strategic_theme",
      "type": "single-select",
      "required": true,
      "enum": ["digital_transformation", "market_expansion", "operational_excellence", "innovation", "sustainability", "cost_optimization"],
      "defaultValue": "operational_excellence",
      "description": "Primary strategic focus area"
    },
    {
      "name": "investment_budget",
      "type": "currency",
      "required": true,
      "min": 10000,
      "description": "Total approved investment budget"
    },
    {
      "name": "target_roi",
      "type": "number",
      "required": true,
      "min": 0,
      "max": 500,
      "defaultValue": 15,
      "description": "Target return on investment percentage"
    },
    {
      "name": "strategic_priority",
      "type": "single-select",
      "required": true,
      "enum": ["critical", "high", "medium", "low"],
      "defaultValue": "medium",
      "description": "Business priority level"
    },
    {
      "name": "risk_tolerance",
      "type": "single-select",
      "required": true,
      "enum": ["conservative", "moderate", "aggressive", "very_aggressive"],
      "defaultValue": "moderate",
      "description": "Risk tolerance for portfolio investments"
    },
    {
      "name": "expected_duration_months",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 60,
      "defaultValue": 12,
      "description": "Expected portfolio duration in months"
    },
    
    // COMPUTED ROLLUP FIELDS - Project Aggregations
    {
      "name": "total_allocated_budget",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "targetField": "approved_budget"
      },
      "description": "Total budget allocated across all projects"
    },
    {
      "name": "total_spent_budget",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "targetField": "spent_budget"
      },
      "description": "Total budget spent across all projects"
    },
    {
      "name": "active_project_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "conditions": {"status": "active"}
      },
      "description": "Number of active projects in portfolio"
    },
    {
      "name": "completed_project_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "conditions": {"status": "completed"}
      },
      "description": "Number of completed projects in portfolio"
    },
    {
      "name": "total_project_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project"
      },
      "description": "Total number of projects in portfolio"
    },
    {
      "name": "average_project_progress",
      "type": "rollup_average",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "targetField": "progress_percentage"
      },
      "description": "Average progress across all projects"
    },
    {
      "name": "high_risk_project_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "conditions": {"risk_level": "high"}
      },
      "description": "Number of high-risk projects"
    },
    {
      "name": "blocked_project_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Project",
        "conditions": {"status": "on_hold"}
      },
      "description": "Number of blocked projects"
    },
    
    // COMPUTED EXPRESSION FIELDS - Portfolio Analytics
    {
      "name": "budget_utilization_percent",
      "type": "computed_expression",
      "expression": "(total_allocated_budget / investment_budget) * 100",
      "dependencies": ["total_allocated_budget", "investment_budget"],
      "description": "Percentage of budget allocated to projects"
    },
    {
      "name": "budget_burn_rate_percent",
      "type": "computed_expression",
      "expression": "(total_spent_budget / investment_budget) * 100",
      "dependencies": ["total_spent_budget", "investment_budget"],
      "description": "Percentage of total budget spent"
    },
    {
      "name": "portfolio_completion_rate",
      "type": "computed_expression",
      "expression": "total_project_count > 0 ? (completed_project_count / total_project_count) * 100 : 0",
      "dependencies": ["completed_project_count", "total_project_count"],
      "description": "Percentage of projects completed"
    },
    {
      "name": "portfolio_health_score",
      "type": "computed_formula",
      "expression": "((average_project_progress * 0.4) + ((100 - budget_burn_rate_percent) * 0.3) + (portfolio_completion_rate * 0.3)) * (blocked_project_count == 0 ? 1 : 0.8)",
      "dependencies": ["average_project_progress", "budget_burn_rate_percent", "portfolio_completion_rate", "blocked_project_count"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Overall portfolio health score (0-100)"
    },
    {
      "name": "risk_exposure_score",
      "type": "computed_expression",
      "expression": "total_project_count > 0 ? (high_risk_project_count / total_project_count) * 100 : 0",
      "dependencies": ["high_risk_project_count", "total_project_count"],
      "description": "Percentage of projects with high risk"
    },
    {
      "name": "remaining_budget",
      "type": "computed_expression",
      "expression": "investment_budget - total_spent_budget",
      "dependencies": ["investment_budget", "total_spent_budget"],
      "description": "Remaining available budget"
    },
    {
      "name": "projected_final_cost",
      "type": "computed_formula",
      "expression": "average_project_progress > 0 ? (total_spent_budget / average_project_progress) * 100 : total_allocated_budget",
      "dependencies": ["total_spent_budget", "average_project_progress", "total_allocated_budget"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Projected total cost at completion"
    },
    {
      "name": "budget_variance_percent",
      "type": "computed_expression",
      "expression": "total_allocated_budget > 0 ? ((projected_final_cost - total_allocated_budget) / total_allocated_budget) * 100 : 0",
      "dependencies": ["projected_final_cost", "total_allocated_budget"],
      "description": "Projected budget variance percentage"
    },
    {
      "name": "expected_completion_date",
      "type": "computed_formula",
      "expression": "addMonths($today, expected_duration_months)",
      "dependencies": ["expected_duration_months"],
      "resultType": "date",
      "computeLocation": "backend",
      "description": "Expected portfolio completion date"
    },
    
    // RELATIONSHIP FIELDS - Management Structure
    {
      "name": "portfolio_manager_id",
      "type": "custom_user_reference",
      "relationshipType": "managed_by",
      "required": true,
      "description": "Primary portfolio manager responsible for execution"
    },
    {
      "name": "executive_sponsor_id",
      "type": "custom_user_reference",
      "relationshipType": "sponsored_by",
      "required": true,
      "description": "Executive sponsor providing strategic oversight"
    },
    {
      "name": "steering_committee_members",
      "type": "custom_user_reference",
      "relationshipType": "overseen_by",
      "cardinality": "many-to-many",
      "description": "Steering committee members for governance"
    },
    {
      "name": "budget_approver_id",
      "type": "custom_user_reference",
      "relationshipType": "budget_approved_by",
      "required": true,
      "description": "Financial authority for budget approvals"
    }
  ],
  
  "businessRules": {
    "validation": [
      "investment_budget must be greater than 0",
      "target_roi must be realistic for strategic_theme",
      "portfolio_manager_id and executive_sponsor_id cannot be the same person"
    ],
    "workflows": [
      {
        "name": "portfolio_approval",
        "trigger": "entity_create",
        "approvers": ["executive_sponsor_id", "budget_approver_id"],
        "sequence": "sequential"
      },
      {
        "name": "budget_increase_approval",
        "trigger": "field_change",
        "field": "investment_budget",
        "condition": "new_value > old_value * 1.1",
        "approvers": ["budget_approver_id"]
      }
    ]
  }
}