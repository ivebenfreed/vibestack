{
  "name": "vibestack-issue-27",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/setup-dev-ports.js && turbo run dev --filter=./apps/web --filter=./apps/server",
    "dev:local": "node scripts/setup-dev-ports.js turbo run dev:local --filter=./apps/web --filter=./apps/server",
    "dev:pr": "node scripts/setup-dev-ports.js && turbo run dev:pr --filter=./apps/web --filter=./apps/server",
    "dev:pr:local": "node scripts/setup-dev-ports.js && turbo run dev:pr:local --filter=./apps/web --filter=./apps/server",
    "dev:debug": "turbo run dev:debug --filter=./apps/web --filter=./apps/server",
    "dev:debug:local": "turbo run dev:debug:local --filter=./apps/web --filter=./apps/server",
    "dev:info": "turbo run dev:info --filter=./apps/web --filter=./apps/server",
    "dev:info:local": "turbo run dev:info:local --filter=./apps/web --filter=./apps/server",
    "dev:web": "turbo run dev --filter=./apps/web",
    "dev:web:local": "turbo run dev:local --filter=./apps/web",
    "dev:web:debug": "turbo run dev:debug --filter=./apps/web",
    "dev:web:debug:local": "turbo run dev:debug:local --filter=./apps/web",
    "_build:web:for_pwa_test": "turbo build --filter=vibestack-web",
    "dev:pwa-test": "pnpm _build:web:for_pwa_test && turbo run _start_servers_for_pwa_test --filter=vibestack-web --filter=server",
    "dev:pwa-test:local": "pnpm _build:web:for_pwa_test && turbo run _start_servers_for_pwa_test:local --filter=vibestack-web --filter=server",
    "lint": "eslint . --cache --cache-location=.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location=.eslintcache",
    "lint:staged": "./scripts/lint-staged.sh",
    "type-check": "./scripts/type-check-focused/type-check-all.sh",
    "type-check:watch": "tsc --build --watch",
    "type-check:quick": "./scripts/quick-type-check.sh",
    "type-errors": "./scripts/show-type-errors.sh",
    "check": "pnpm run type-check && pnpm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "npx only-allow pnpm",
    "cli": "pnpm --filter @repo/cli cli",
    "forge:build": "pnpm --filter @repo/dataforge forge:build",
    "forge:migrate:generate": "pnpm --filter @repo/dataforge forge:migrate generate",
    "forge:migrate:run": "pnpm --filter @repo/dataforge forge:migrate run",
    "forge:migrate:run:preview": "pnpm --filter @repo/dataforge forge:migrate:preview run",
    "forge:migrate:run:production": "pnpm --filter @repo/dataforge forge:migrate:production run",
    "forge:migrate:local": "pnpm --filter @repo/dataforge migration:run:local",
    "forge:migrate:local:generate": "pnpm --filter @repo/dataforge migration:generate:local",
    "forge:migrate:local:show": "pnpm --filter @repo/dataforge migration:show:local",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose stop",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:logs": "docker-compose logs -f",
    "forge:deploy": "pnpm --filter @repo/dataforge deploy",
    "deploy": "pnpm type-check && pnpm deploy:server && pnpm deploy:web",
    "deploy:local": "echo 'Local deployment not applicable - use dev:local instead'",
    "deploy:server": "cd apps/server && wrangler deploy",
    "deploy:server:local": "echo 'Local server deployment not applicable - use dev:local instead'",
    "deploy:web": "pnpm --filter vibestack-web cf:deploy",
    "deploy:web:local": "echo 'Local web deployment not applicable - use dev:local instead'",
    "deploy:production": "pnpm type-check && pnpm deploy:server:production && pnpm deploy:web:production",
    "deploy:server:production": "cd apps/server && wrangler deploy --env production",
    "deploy:web:production": "pnpm --filter vibestack-web cf:deploy:production",
    "logs": "./scripts/view-logs.sh",
    "logs:tail": "./scripts/tail-logs.sh",
    "logs:errors": "./scripts/view-logs.sh --errors",
    "logs:cull": "./scripts/cull-logs.sh",
    "ensure-docker:local": "node scripts/ensure-docker-services.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.54.2",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.25.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "packageManager": "pnpm@8.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "kysely": "^0.27.0"
    }
  },
  "dependencies": {
    "playwright": "^1.54.2"
  }
}
