{
  "name": "vibestack",
  "private": true,
  "scripts": {
    "build": "turbo build --filter=!./packages/sync-test",
    "dev": "turbo run dev --filter=./apps/web --filter=./apps/server --filter=./packages/cron-tester",
    "dev:debug": "turbo run dev:debug --filter=./apps/web --filter=./apps/server ",
    "dev:info": "turbo run dev:info --filter=./apps/web --filter=./apps/server",
    "dev:web": "turbo run dev --filter=./apps/web",
    "dev:web:debug": "turbo run dev:debug --filter=./apps/web",
    "_build:web:for_pwa_test": "turbo build --filter=vibestack-web",
    "dev:pwa-test": "pnpm _build:web:for_pwa_test && turbo run _start_servers_for_pwa_test --filter=vibestack-web --filter=server",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "turbo run typecheck --filter=./apps/server && cd apps/web && npx tsc --noEmit",
    "quality": "pnpm --filter @repo/code-quality build && pnpm --filter @repo/code-quality quality",
    "prebuild": "pnpm quality",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "npx only-allow pnpm",
    "cli": "pnpm --filter @repo/cli cli",
    "forge:build": "pnpm --filter @repo/dataforge forge:build",
    "forge:migrate:generate": "pnpm --filter @repo/dataforge forge:migrate generate",
    "forge:migrate:run": "pnpm --filter @repo/dataforge forge:migrate run",
    "forge:deploy": "pnpm --filter @repo/dataforge deploy",
    "deploy": "pnpm deploy:server && pnpm deploy:web",
    "deploy:server": "cd apps/server && wrangler deploy",
    "deploy:web": "pnpm --filter vibestack-web cf:deploy",
    "deploy:production": "pnpm deploy:server:production && pnpm deploy:web:production",
    "deploy:server:production": "cd apps/server && wrangler deploy --env production",
    "deploy:web:production": "pnpm --filter vibestack-web cf:deploy:production"
  },
  "devDependencies": {
    "@repo/code-quality": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@8.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@electric-sql/pglite-react": "^0.2.18",
    "@electric-sql/pglite-repl": "^0.2.18",
    "@modelcontextprotocol/server-brave-search": "^0.6.2",
    "@modelcontextprotocol/server-postgres": "^0.6.2",
    "hono": "^4.7.8",
    "jotai": "^2.12.5",
    "position-observer": "^1.0.0",
    "rich-textarea": "^0.26.4",
    "tailwindcss": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "kysely": "^0.27.0"
    }
  }
}
