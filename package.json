{
  "name": "elevra",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @repo/sync-types build && pnpm --filter ./apps/worker build",
    "dev": "pnpm ensure-docker:local && pnpm --filter ./apps/worker dev",
    "dev:local": "pnpm ensure-docker:local && pnpm --filter ./apps/worker dev",
    "dev:pr": "pnpm --filter ./apps/worker dev",
    "dev:pr:local": "pnpm --filter ./apps/worker dev",
    "dev:quiet": "./scripts/dev-with-logging.sh quiet",
    "dev:sync": "./scripts/dev-with-logging.sh sync",
    "dev:ui": "./scripts/dev-with-logging.sh ui",
    "dev:ui:quiet-vibegrid": "./scripts/dev-with-logging.sh ui-quiet-vibegrid",
    "dev:ui:focus-vibegrid": "./scripts/dev-with-logging.sh ui-focus-vibegrid",
    "dev:debug": "./scripts/dev-with-logging.sh debug",
    "dev:debug:quiet-vibegrid": "./scripts/dev-with-logging.sh debug-quiet-vibegrid",
    "dev:all": "./scripts/dev-with-logging.sh all",
    "dev:focus": "./scripts/dev-with-logging.sh focus-file universe-loader",
    "lint": "eslint . --cache --cache-location=.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location=.eslintcache",
    "lint:staged": "./scripts/lint-staged.sh",
    "type-check": "./scripts/type-check-focused/type-check-all.sh",
    "type-check:watch": "tsc --build --watch",
    "type-check:quick": "./scripts/quick-type-check.sh",
    "type-errors": "./scripts/show-type-errors.sh",
    "check": "pnpm run type-check && pnpm run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preinstall": "npx only-allow pnpm",
    "cli": "pnpm --filter @repo/cli cli",
    "db:start": "./main-postgres/start.sh",
    "db:stop": "./main-postgres/stop.sh",
    "db:reset": "cd main-postgres && docker compose down -v && ./start.sh",
    "db:logs": "./main-postgres/logs.sh",
    "db:backup": "./main-postgres/backup.sh",
    "db:psql": "./main-postgres/psql.sh",
    "deploy": "pnpm type-check && pnpm build && pnpm --filter ./apps/worker build:worker",
    "deploy:production": "pnpm type-check && pnpm build && pnpm --filter ./apps/worker build:worker",
    "logs": "./scripts/view-logs.sh",
    "logs:tail": "./scripts/tail-logs.sh",
    "logs:errors": "./scripts/view-logs.sh --errors",
    "logs:cull": "./scripts/cull-logs.sh",
    "ensure-docker:local": "node scripts/ensure-docker-services.js",
    "setup:env": "node scripts/setup-worktree-env.js",
    "setup:worktree": "pnpm install && node scripts/setup-worktree-env.js && echo '✅ Worktree setup complete'",
    "log:help": "./scripts/set-log-focus.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/mcp": "^0.0.34",
    "@playwright/test": "^1.54.2",
    "@repo/eslint-config": "workspace:*",
    "@types/pg": "^8.15.5",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "packageManager": "pnpm@9.15.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "kysely": "^0.27.0"
    },
    "patchedDependencies": {
      "better-auth": "patches/better-auth.patch"
    }
  },
  "dependencies": {
    "@hono/standard-validator": "^0.1.5",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "cloudflared": "^0.7.1",
    "optional": "^0.1.4",
    "playwright": "^1.54.2"
  }
}
