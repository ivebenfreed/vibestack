# Web Application Environment Configuration Example
# Copy this file to .env.development, .env.staging, or .env.production

# API Configuration
# The backend server URL that the web app will connect to
VITE_API_URL=http://127.0.0.1:8787

# Auth Configuration
# Authentication is now handled by the main server
# VITE_AUTH_CLIENT_ID=vibestack-web

# Google OAuth Configuration (Optional - for client-side OAuth flows)
# These should match the server-side Google OAuth configuration
# Only needed if implementing client-side OAuth flows
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Environment Configuration
VITE_ENVIRONMENT=development

# PWA Configuration (Optional)
# VITE_PWA_ENABLED=true
# VITE_PWA_NAME="VibeStack"
# VITE_PWA_SHORT_NAME="VibeStack"
# VITE_PWA_DESCRIPTION="Local-first task management with real-time sync"