import React from 'react'
import type { BaseEntity, OptimusColumn } from '../types'

interface EnumEditorProps<TEntity extends BaseEntity> {
  row: TEntity
  column: OptimusColumn<TEntity>
  onRowChange: (row: TEntity) => void
  onClose: (commitChanges?: boolean) => void
}

/**
 * Rich enum editor for renderEditCell
 * Full-featured dropdown with keyboard navigation
 */
export function EnumEditor<TEntity extends BaseEntity>({
  row,
  column,
  onRowChange,
  onClose
}: EnumEditorProps<TEntity>) {
  const value = row[column.key] || ''
  const config = column.config || {}
  const enumValues = config.enumValues || {}
  
  const handleChange = (newValue: string) => {
    onRowChange({
      ...row,
      [column.key]: newValue || null
    } as TEntity)
  }
  
  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter') {
      onClose(true)
    } else if (e.key === 'Escape') {
      onClose(false)
    } else if (e.key === 'Tab') {
      onClose(true)
    }
  }
  
  // Get available options from enum values
  const options = Object.entries(enumValues).map(([key, label]) => ({
    value: key,
    label: String(label)
  }))
  
  return (
    <select
      value={String(value)}
      onChange={(e) => handleChange(e.target.value)}
      onBlur={() => onClose(true)}
      onKeyDown={handleKeyDown}
      className="w-full h-full border-0 outline-0 px-2 bg-background text-foreground focus:bg-background cursor-pointer"
      autoFocus
    >
      <option value="">-- Select --</option>
      {options.map(option => (
        <option key={option.value} value={option.value}>
          {option.label}
        </option>
      ))}
    </select>
  )
}