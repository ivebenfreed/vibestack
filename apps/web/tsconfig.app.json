{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    
    // Web-specific settings
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    
    // Bundler mode
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    
    // Paths
    "baseUrl": ".",
    "paths": {
      "@repo/dataforge/client-entities": ["../../packages/dataforge/dist/generated/client-entities.d.ts"],
      "@repo/sync-types": ["../../packages/sync-types/dist/index.d.ts"],
      "@/*": ["./src/*"]
    },
    
    // Additional checks
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/components/ui/**", "**/*.backup*", "**/*.original*", "**/*.bak"]
}