{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "prebuild": "echo 'DataForge moved to server - no prebuild needed'",
    "build": "../../scripts/type-check-focused/type-check-all.sh && wrangler deploy --outdir=dist",
    "dev": "wrangler dev --port ${SERVER_PORT:-8787} --ip 127.0.0.1",
    "dev:local": "wrangler dev --port ${SERVER_PORT:-8787} --ip 127.0.0.1",
    "dev:pr": "wrangler dev --port ${SERVER_PORT:-8787} --ip 127.0.0.1",
    "dev:pr:local": "wrangler dev --port ${SERVER_PORT:-8787} --ip 127.0.0.1",
    "dev:no-logs": "wrangler dev --ip 127.0.0.1",
    "dev:no-logs:local": "wrangler dev --ip 127.0.0.1",
    "_start_servers_for_pwa_test": "wrangler dev",
    "_start_servers_for_pwa_test:local": "wrangler dev",
    "dev:debug": "LOG_LEVEL=debug wrangler dev --ip 127.0.0.1",
    "dev:debug:local": "LOG_LEVEL=debug wrangler dev --ip 127.0.0.1",
    "dev:info": "wrangler dev --ip 127.0.0.1",
    "dev:info:local": "wrangler dev --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ensure-docker:local": "node ../../scripts/ensure-docker-services.js"
  },
  "dependencies": {
    "@cloudflare/actors": "0.0.1-beta.3",
    "@hono/zod-validator": "^0.1.11",
    "@neondatabase/serverless": "^1.0.1",
    "@openauthjs/openauth": "^0.4.3",
    "@polar-sh/better-auth": "^1.1.0",
    "@polar-sh/sdk": "^0.34.11",
    "@repo/sync-types": "workspace:*",
    "better-auth": "^1.3.5",
    "class-validator": "^0.14.2",
    "cron-schedule": "^5.0.4",
    "dotenv": "^16.4.5",
    "hono": "^4.7.7",
    "kysely": "^0.27.0",
    "kysely-neon-http": "^1.0.0",
    "localtunnel": "^2.0.2",
    "node-fetch": "^3.3.2",
    "resend": "^4.0.0",
    "uuidv7": "^1.0.2",
    "valibot": "^1.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/ws": "^8.18.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2",
    "wrangler": "^4.31.0",
    "ws": "^8.18.3"
  }
}
