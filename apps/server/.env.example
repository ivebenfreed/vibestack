# Server Environment Configuration Example
# Copy this file to .env.development, .env.staging, or .env.production
# Environment variables are primarily managed via Cloudflare Workers Dashboard

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database

# Neon Database API (for replication management)
NEON_API_KEY=your_neon_api_key

# Better Auth Configuration
BETTER_AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth Configuration
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Go to Credentials > Create Credentials > OAuth 2.0 Client IDs
# 5. Set Authorized redirect URIs to:
#    - http://localhost:5173/api/auth/callback/google (development)
#    - https://dev.codevibesmatter.com/api/auth/callback/google (staging)
#    - https://app.codevibesmatter.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Resend Email Service Configuration
# Get your API key from https://resend.com/api-keys
# Configure your domain at https://resend.com/domains
RESEND_API_KEY=re_your_resend_api_key

# Environment Configuration
ENVIRONMENT=development
NODE_ENV=development
TYPEORM_LOGGING=true

# API Configuration (for external services)
API_URL=http://127.0.0.1:8787