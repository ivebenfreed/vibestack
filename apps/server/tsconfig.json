{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    
    // Server-specific settings
    "jsx": "react-jsx",
    "composite": true,
    "outDir": "./dist",
    "rootDir": "../..", // Allow imports from workspace root
    
    // Path mappings
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@repo/sync-types": ["../../packages/sync-types/src"],
      "@repo/dataforge/*": ["../../packages/dataforge/src/*"]
    },
    
    // Relax some strictness for Workers environment
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", ".wrangler", "**/*.test.ts"]
}