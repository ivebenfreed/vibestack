---
import LeadCaptureForm from './LeadCaptureForm.jsx';
import { getEntry } from 'astro:content';

const heroEntry = await getEntry('sections', 'hero');
const hero = heroEntry.data;
---

<section class="hero">
    <div class="hero-bg">
        <div class="gradient-orb orb-1"></div>
        <div class="gradient-orb orb-2"></div>
        <div class="gradient-orb orb-3"></div>
    </div>
    <div class="container">
        <div class="hero-content">
            <div class="hero-badge">{hero.badge}</div>
            <h1 class="hero-title">
                <span class="word-slide">
                    <span>{hero.headline.line1}</span>
                </span>
                <br>
                <span class="highlight">{hero.headline.line2} <span class="accent-word">{hero.headline.highlight}</span></span>
            </h1>
            <p class="subheading">
                {hero.subheading.words.map((word, i) => (
                    <span class="fade-in-word">{word}{' '}</span>
                ))}<br>
                With <span class="accent">{hero.subheading.accent}</span> {hero.subheading.suffix}
            </p>
            
            <div class="performance-badges">
                {hero.badges.map(badge => (
                    <div class="badge">
                        <div class="badge-icon">{badge.icon}</div>
                        {badge.text}
                    </div>
                ))}
            </div>

            <div class="lead-capture">
                <h2>{hero.cta.title}</h2>
                <p class="offer">{hero.cta.subtitle}</p>
                
                <LeadCaptureForm client:load />
                
                <p class="privacy-note">{hero.cta.privacy}</p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero {
        padding: 140px 0 80px;
        background: linear-gradient(135deg, #0F172A 0%, #1E3A5F 100%);
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        display: flex;
        align-items: center;
    }
    
    .hero-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        opacity: 0.3;
    }
    
    .gradient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        animation: float-orb 20s infinite;
    }
    
    .orb-1 {
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, #0EA5E9 0%, transparent 70%);
        top: -200px;
        left: -200px;
        animation-duration: 25s;
    }
    
    .orb-2 {
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, #10B981 0%, transparent 70%);
        bottom: -100px;
        right: -100px;
        animation-duration: 20s;
        animation-delay: -5s;
    }
    
    .orb-3 {
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, #38BDF8 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation-duration: 30s;
        animation-delay: -10s;
    }
    
    @keyframes float-orb {
        0%, 100% {
            transform: translate(0, 0) rotate(0deg);
        }
        33% {
            transform: translate(30px, -30px) rotate(120deg);
        }
        66% {
            transform: translate(-20px, 20px) rotate(240deg);
        }
    }

    .hero::before {
        content: '';
        position: absolute;
        width: 200%;
        height: 200%;
        background: url('data:image/svg+xml,<svg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"><g fill="none" fill-rule="evenodd"><g fill="%23ffffff" fill-opacity="0.05"><path d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/></g></g></svg>') repeat;
        animation: float 20s linear infinite;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        text-align: center;
        color: white;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        color: white;
        margin-bottom: 30px;
        animation: fadeInDown 0.8s ease-out;
    }
    
    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .hero h1 {
        font-size: 84px;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 30px;
        letter-spacing: -4px;
    }
    
    .hero-title .word-slide {
        display: inline-block;
        overflow: hidden;
    }
    
    .hero-title .word-slide span {
        display: inline-block;
        animation: slideUp 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    
    @keyframes slideUp {
        from {
            transform: translateY(100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    .gradient-text {
        background: linear-gradient(90deg, #fff 0%, rgba(255,255,255,0.8) 50%, #fff 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer 3s linear infinite;
    }
    
    @keyframes shimmer {
        to {
            background-position: 200% center;
        }
    }
    
    .highlight {
        position: relative;
    }
    
    .accent-word {
        position: relative;
        color: #10B981;
        text-shadow: 0 0 40px rgba(16, 185, 129, 0.8);
        animation: glow-pulse 2s ease-in-out infinite;
    }
    
    @keyframes glow-pulse {
        0%, 100% {
            text-shadow: 0 0 40px rgba(16, 185, 129, 0.8);
        }
        50% {
            text-shadow: 0 0 60px rgba(16, 185, 129, 1);
        }
    }

    .hero .subheading {
        font-size: 26px;
        font-weight: 400;
        margin-bottom: 50px;
        opacity: 0.95;
        line-height: 1.6;
    }
    
    .fade-in-word {
        display: inline-block;
        animation: fadeInWord 0.5s ease-out forwards;
        opacity: 0;
    }
    
    .fade-in-word:nth-child(1) { animation-delay: 0.8s; }
    .fade-in-word:nth-child(2) { animation-delay: 0.9s; }
    .fade-in-word:nth-child(3) { animation-delay: 1.0s; }
    .fade-in-word:nth-child(4) { animation-delay: 1.1s; }
    .fade-in-word:nth-child(5) { animation-delay: 1.2s; }
    .fade-in-word:nth-child(6) { animation-delay: 1.3s; }
    .fade-in-word:nth-child(7) { animation-delay: 1.4s; }
    .fade-in-word:nth-child(8) { animation-delay: 1.5s; }
    
    @keyframes fadeInWord {
        to {
            opacity: 1;
        }
    }
    
    .subheading .accent {
        color: #10B981;
        font-weight: 700;
        text-shadow: 0 0 30px rgba(16, 185, 129, 0.6);
        position: relative;
    }
    
    .subheading .accent::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #10B981, transparent);
        animation: slideIn 1s ease-out 1.8s both;
    }
    
    @keyframes slideIn {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    .performance-badges {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }

    .badge {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .badge-icon {
        width: 20px;
        height: 20px;
        background: var(--success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lead-capture {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px) saturate(180%);
        border-radius: 24px;
        padding: 48px;
        max-width: 500px;
        margin: 60px auto 0;
        box-shadow: 
            0 25px 80px rgba(0, 0, 0, 0.15),
            0 0 0 1px rgba(255, 255, 255, 0.5) inset;
        border: 1px solid rgba(255, 255, 255, 0.2);
        animation: fadeInUp 0.8s ease-out 0.8s both;
        position: relative;
        overflow: hidden;
    }
    
    .lead-capture::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(91, 79, 255, 0.05), transparent);
        animation: float 15s linear infinite;
    }

    .lead-capture h2 {
        color: var(--dark);
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 12px;
        background: linear-gradient(135deg, #0EA5E9 0%, #10B981 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        z-index: 1;
    }

    .lead-capture .offer {
        color: var(--gray);
        margin-bottom: 35px;
        font-size: 16px;
        position: relative;
        z-index: 1;
    }

    :global(.lead-form .submit-button) {
        width: 100%;
        padding: 14px 20px;
        font-size: 18px;
    }

    :global(.lead-form .error-message) {
        color: #EF4444;
        margin-bottom: 15px;
    }

    :global(.success-message) {
        text-align: center;
        padding: 40px 0;
    }

    :global(.success-message h3) {
        color: var(--dark);
        margin-bottom: 10px;
    }

    :global(.success-message p) {
        color: var(--gray);
    }

    .privacy-note {
        text-align: center;
        color: var(--gray);
        font-size: 12px;
        margin-top: 15px;
    }

    @media (max-width: 768px) {
        .hero h1 {
            font-size: 48px;
            letter-spacing: -2px;
        }

        .hero .subheading {
            font-size: 20px;
        }
        
        .hero-badge {
            font-size: 10px;
            padding: 6px 16px;
        }
    }
</style>