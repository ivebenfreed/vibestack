{
  "name": "@vibestack/ui-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:playwright",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:auth": "playwright test auth/",
    "test:playwright:dashboard": "playwright test dashboard/",
    "test:playwright:entities": "playwright test entities/",
    "test:playwright:update-snapshots": "playwright test --update-snapshots",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test e2e/",
    "test:a11y": "playwright test --grep @a11y",
    "test:smoke": "playwright test --grep @smoke",
    "test:performance": "playwright test --grep @performance",
    "codegen": "playwright codegen",
    "show-report": "playwright show-report test-results/html",
    "show-trace": "playwright show-trace",
    "install:browsers": "playwright install --with-deps",
    "screenshots:update": "playwright test --update-snapshots --grep @visual",
    "screenshots:verify": "playwright test --grep @visual"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@playwright/test": "^1.42.0",
    "@vitest/coverage-v8": "^1.3.0",
    "@vitest/ui": "^1.3.0",
    "lighthouse": "^11.6.0",
    "playwright-lighthouse": "^3.2.5",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "date-fns": "^3.3.1"
  }
}