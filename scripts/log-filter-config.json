{
  "filterPatterns": {
    "polling": [
      "GET /api/health",
      "GET /health",
      "OPTIONS /api",
      "Heartbeat.*success",
      "heartbeat.*received",
      "ping.*pong",
      "keep-alive"
    ],
    "wranglerRoutine": [
      "GET /cdn-cgi",
      "GET /favicon.ico",
      "InformationalLog",
      "------ Waiting for file changes ------",
      "⎔ Reloading local server"
    ],
    "webSocketRoutine": [
      "WebSocket.*opened",
      "WebSocket.*closed.*1000",
      "ws.*ping",
      "ws.*pong"
    ],
    "syncRoutine": [
      "sync.*heartbeat",
      "sync.*keep.*alive",
      "live_changes.*empty",
      "no.*changes.*to.*sync"
    ],
    "assets": [
      "\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf)(\\?|$)"
    ]
  },
  "includePatterns": {
    "errors": [
      "[Ee]rror",
      "[Ww]arn",
      "[Ff]ail",
      "[Ee]xception",
      "[Cc]rash",
      "500",
      "401",
      "403",
      "404"
    ],
    "importantEvents": [
      "[Ss]tarted",
      "[Ss]topped",
      "[Cc]onnected",
      "[Dd]isconnected",
      "[Aa]uth",
      "[Ll]ogin",
      "[Ll]ogout"
    ],
    "database": [
      "[Dd]atabase",
      "[Ss]ql",
      "[Qq]uery",
      "[Mm]igration",
      "neon",
      "typeorm"
    ],
    "apiMutations": [
      "POST /api",
      "PUT /api",
      "DELETE /api",
      "PATCH /api"
    ],
    "syncImportant": [
      "sync.*started",
      "sync.*completed",
      "sync.*error",
      "replication",
      "conflict",
      "merge"
    ],
    "development": [
      "Building",
      "Built",
      "Compiled",
      "Ready on",
      "Error compiling"
    ]
  },
  "logSettings": {
    "maxLogSizeMB": 10,
    "timestampFormat": "%Y-%m-%d %H:%M:%S",
    "logDirectory": "apps/server/logs",
    "fullLogFile": "server.log",
    "filteredLogFile": "server-filtered.log"
  }
}