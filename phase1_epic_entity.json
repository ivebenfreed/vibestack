{
  "entityName": "Epic",
  "archetype": "collection",
  "description": "Epic management for organizing features with comprehensive task aggregation and progress tracking",
  "customFields": [
    {
      "name": "epic_code",
      "type": "text",
      "required": true,
      "unique": true,
      "regex": "^[A-Z]{2,4}-EPIC-[0-9]{1,3}$",
      "description": "Unique epic identifier (e.g., WEB-EPIC-1, API-EPIC-25)"
    },
    {
      "name": "epic_theme",
      "type": "text",
      "required": true,
      "description": "High-level theme or feature area"
    },
    {
      "name": "business_value",
      "type": "number",
      "required": true,
      "min": 1,
      "max": 100,
      "description": "Business value score (1-100)"
    },
    {
      "name": "user_impact",
      "type": "single-select",
      "required": true,
      "enum": ["low", "medium", "high", "critical"],
      "defaultValue": "medium",
      "description": "Expected impact on end users"
    },
    {
      "name": "strategic_alignment",
      "type": "single-select",
      "required": true,
      "enum": ["strongly_aligned", "aligned", "somewhat_aligned", "not_aligned"],
      "defaultValue": "aligned",
      "description": "Alignment with strategic objectives"
    },
    {
      "name": "market_opportunity",
      "type": "single-select",
      "enum": ["transformational", "significant", "moderate", "incremental"],
      "defaultValue": "moderate",
      "description": "Size of market opportunity"
    },
    {
      "name": "effort_complexity",
      "type": "single-select",
      "required": true,
      "enum": ["simple", "moderate", "complex", "highly_complex"],
      "defaultValue": "moderate",
      "description": "Overall effort complexity assessment"
    },
    {
      "name": "technical_risk",
      "type": "single-select",
      "required": true,
      "enum": ["low", "medium", "high", "very_high"],
      "defaultValue": "medium",
      "description": "Technical implementation risk"
    },
    {
      "name": "target_release",
      "type": "text",
      "description": "Target release version or milestone"
    },
    {
      "name": "hypothesis",
      "type": "rich-text",
      "description": "Hypothesis about user need and expected outcome"
    },
    {
      "name": "success_criteria",
      "type": "rich-text",
      "required": true,
      "description": "Measurable criteria for epic success"
    },
    
    // EPIC SCOPE & ESTIMATION
    {
      "name": "estimated_duration_weeks",
      "type": "number",
      "min": 1,
      "max": 52,
      "description": "Estimated duration in weeks"
    },
    {
      "name": "target_completion_date",
      "type": "date",
      "description": "Target completion date"
    },
    {
      "name": "minimum_viable_scope",
      "type": "rich-text",
      "description": "Minimum scope required for epic to provide value"
    },
    {
      "name": "nice_to_have_scope",
      "type": "rich-text",
      "description": "Additional scope that would be valuable but not critical"
    },
    
    // TASK AGGREGATION ROLLUPS
    {
      "name": "total_story_points",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "story_points"
      },
      "description": "Total story points across all tasks"
    },
    {
      "name": "completed_story_points",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "story_points",
        "conditions": {"status": "done"}
      },
      "description": "Story points completed"
    },
    {
      "name": "total_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task"
      },
      "description": "Total number of tasks in epic"
    },
    {
      "name": "completed_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "done"}
      },
      "description": "Number of completed tasks"
    },
    {
      "name": "active_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "active"}
      },
      "description": "Number of active tasks"
    },
    {
      "name": "blocked_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "blocked"}
      },
      "description": "Number of blocked tasks"
    },
    {
      "name": "not_started_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"status": "not_started"}
      },
      "description": "Number of tasks not yet started"
    },
    {
      "name": "high_priority_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"priority": "high"}
      },
      "description": "Number of high-priority tasks"
    },
    {
      "name": "critical_priority_task_count",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "conditions": {"priority": "critical"}
      },
      "description": "Number of critical-priority tasks"
    },
    
    // TIME & RESOURCE AGGREGATION
    {
      "name": "total_estimated_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "current_estimate"
      },
      "description": "Total estimated hours across all tasks"
    },
    {
      "name": "total_actual_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "actual_hours"
      },
      "description": "Total actual hours logged across all tasks"
    },
    {
      "name": "total_remaining_hours",
      "type": "rollup_sum",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "remaining_hours"
      },
      "description": "Total remaining hours across all tasks"
    },
    {
      "name": "assigned_team_size",
      "type": "rollup_count",
      "rollupConfig": {
        "relationshipType": "belongs_to", 
        "targetEntityType": "Task",
        "targetField": "assignee_id",
        "distinct": true
      },
      "description": "Number of unique people assigned to epic tasks"
    },
    
    // COMPUTED PROGRESS METRICS
    {
      "name": "epic_progress_by_tasks",
      "type": "computed_expression",
      "expression": "total_task_count > 0 ? (completed_task_count / total_task_count) * 100 : 0",
      "dependencies": ["completed_task_count", "total_task_count"],
      "description": "Progress percentage based on task completion"
    },
    {
      "name": "epic_progress_by_story_points",
      "type": "computed_expression",
      "expression": "total_story_points > 0 ? (completed_story_points / total_story_points) * 100 : 0",
      "dependencies": ["completed_story_points", "total_story_points"],
      "description": "Progress percentage based on story points"
    },
    {
      "name": "epic_progress_by_hours",
      "type": "computed_expression",
      "expression": "total_estimated_hours > 0 ? ((total_estimated_hours - total_remaining_hours) / total_estimated_hours) * 100 : 0",
      "dependencies": ["total_estimated_hours", "total_remaining_hours"],
      "description": "Progress percentage based on hours completed"
    },
    {
      "name": "weighted_progress",
      "type": "computed_formula",
      "expression": "(epic_progress_by_story_points * 0.5) + (epic_progress_by_hours * 0.3) + (epic_progress_by_tasks * 0.2)",
      "dependencies": ["epic_progress_by_story_points", "epic_progress_by_hours", "epic_progress_by_tasks"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Weighted average progress across all metrics"
    },
    
    // TIME PERFORMANCE METRICS
    {
      "name": "time_variance_percent",
      "type": "computed_expression",
      "expression": "total_estimated_hours > 0 ? ((total_actual_hours - total_estimated_hours) / total_estimated_hours) * 100 : 0",
      "dependencies": ["total_actual_hours", "total_estimated_hours"],
      "description": "Time variance percentage (positive = over estimate)"
    },
    {
      "name": "completion_efficiency",
      "type": "computed_expression",
      "expression": "total_actual_hours > 0 ? total_estimated_hours / total_actual_hours : 1",
      "dependencies": ["total_estimated_hours", "total_actual_hours"],
      "description": "Efficiency ratio (>1 = under estimate, <1 = over estimate)"
    },
    {
      "name": "projected_total_hours",
      "type": "computed_formula",
      "expression": "weighted_progress > 0 ? (total_actual_hours / (weighted_progress / 100)) : total_estimated_hours",
      "dependencies": ["total_actual_hours", "weighted_progress", "total_estimated_hours"],
      "resultType": "number",
      "computeLocation": "backend",
      "description": "Projected total hours at completion"
    },
    {
      "name": "projected_completion_date",
      "type": "computed_formula",
      "expression": "total_remaining_hours > 0 && assigned_team_size > 0 ? addDays($today, ceil(total_remaining_hours / (assigned_team_size * 40))) : target_completion_date",
      "dependencies": ["total_remaining_hours", "assigned_team_size", "target_completion_date"],
      "resultType": "date",
      "computeLocation": "backend",
      "description": "Projected completion date based on current velocity"
    },
    {
      "name": "schedule_variance_days",
      "type": "computed_expression",
      "expression": "target_completion_date && projected_completion_date ? (projected_completion_date - target_completion_date) : 0",
      "dependencies": ["projected_completion_date", "target_completion_date"],
      "description": "Schedule variance in days (positive = late)"
    },
    
    // QUALITY & RISK METRICS
    {
      "name": "quality_score",
      "type": "rollup_average",
      "rollupConfig": {
        "relationshipType": "belongs_to",
        "targetEntityType": "Task",
        "targetField": "task_health_score"
      },
      "description": "Average quality score across all tasks"
    },
    {
      "name": "risk_exposure",
      "type": "computed_expression",
      "expression": "total_task_count > 0 ? (blocked_task_count / total_task_count) * 100 : 0",
      "dependencies": ["blocked_task_count", "total_task_count"],
      "description": "Percentage of tasks that are blocked"
    },
    {
      "name": "priority_distribution_score",
      "type": "computed_expression",
      "expression": "total_task_count > 0 ? ((critical_priority_task_count * 3) + (high_priority_task_count * 2)) / total_task_count : 0",
      "dependencies": ["critical_priority_task_count", "high_priority_task_count", "total_task_count"],
      "description": "Weighted priority distribution score"
    },
    
    // OVERALL EPIC HEALTH
    {
      "name": "epic_health_score",
      "type": "computed_formula",
      "expression": "((weighted_progress * 0.3) + (quality_score * 0.25) + ((100 - risk_exposure) * 0.2) + (completion_efficiency >= 0.8 ? 100 : completion_efficiency * 125) * 0.15 + ((schedule_variance_days <= 0 ? 100 : max(0, 100 - abs(schedule_variance_days) * 5)) * 0.1))",
      "dependencies": ["weighted_progress", "quality_score", "risk_exposure", "completion_efficiency", "schedule_variance_days"],
      "resultType": "number",
      "computeLocation": "backend",
      "cacheResults": true,
      "description": "Overall epic health score (0-100)"
    },
    {
      "name": "readiness_score",
      "type": "computed_expression",
      "expression": "not_started_task_count == 0 ? 100 : ((total_task_count - not_started_task_count) / total_task_count) * 100",
      "dependencies": ["not_started_task_count", "total_task_count"],
      "description": "Percentage of tasks ready for execution"
    },
    
    // COST & ROI ESTIMATION
    {
      "name": "estimated_cost",
      "type": "computed_expression",
      "expression": "total_estimated_hours * 100",
      "dependencies": ["total_estimated_hours"],
      "description": "Estimated cost at $100/hour"
    },
    {
      "name": "actual_cost",
      "type": "computed_expression", 
      "expression": "total_actual_hours * 100",
      "dependencies": ["total_actual_hours"],
      "description": "Actual cost spent so far"
    },
    {
      "name": "projected_final_cost",
      "type": "computed_expression",
      "expression": "projected_total_hours * 100", 
      "dependencies": ["projected_total_hours"],
      "description": "Projected final cost at completion"
    },
    {
      "name": "cost_variance",
      "type": "computed_expression",
      "expression": "projected_final_cost - estimated_cost",
      "dependencies": ["projected_final_cost", "estimated_cost"],
      "description": "Projected cost variance"
    },
    {
      "name": "roi_estimate",
      "type": "computed_expression",
      "expression": "estimated_cost > 0 ? (business_value * 10000 - estimated_cost) / estimated_cost * 100 : 0",
      "dependencies": ["business_value", "estimated_cost"],
      "description": "Estimated ROI percentage based on business value"
    },
    
    // RELATIONSHIP FIELDS - Epic Organization
    {
      "name": "product_owner_id",
      "type": "custom_user_reference",
      "relationshipType": "owned_by",
      "required": true,
      "description": "Product owner responsible for epic definition and acceptance"
    },
    {
      "name": "epic_lead_id",
      "type": "custom_user_reference",
      "relationshipType": "managed_by",
      "description": "Technical or delivery lead for the epic"
    },
    {
      "name": "stakeholder_group",
      "type": "custom_user_reference",
      "relationshipType": "stakeholder",
      "cardinality": "many-to-many",
      "description": "Key stakeholders with interest in epic outcome"
    },
    {
      "name": "project_id",
      "type": "custom_entity_reference",
      "relationshipType": "belongs_to",
      "targetEntityType": "Project",
      "required": true,
      "description": "Project this epic belongs to"
    },
    {
      "name": "parent_epic_id",
      "type": "custom_entity_reference",
      "relationshipType": "child_of",
      "targetEntityType": "Epic",
      "description": "Parent epic if this is a sub-epic"
    },
    {
      "name": "related_epics",
      "type": "custom_entity_reference",
      "relationshipType": "related_to",
      "targetEntityType": "Epic",
      "cardinality": "many-to-many",
      "description": "Related epics with dependencies or shared scope"
    }
  ],
  
  "businessRules": {
    "validation": [
      "business_value must be justified with success_criteria",
      "estimated_duration_weeks should align with total_estimated_hours",
      "target_completion_date must be in the future",
      "product_owner_id cannot be the same as epic_lead_id",
      "epic must have at least one task to be marked as active"
    ],
    "workflows": [
      {
        "name": "epic_initiation_approval",
        "trigger": "entity_create",
        "approvers": ["product_owner_id", "project.project_manager_id"],
        "sequence": "parallel",
        "description": "Approval required to create new epic"
      },
      {
        "name": "epic_scope_change_approval",
        "trigger": "field_change",
        "field": "estimated_duration_weeks",
        "condition": "new_value > old_value * 1.25",
        "approvers": ["product_owner_id", "project.sponsor_id"],
        "sequence": "sequential",
        "description": "Approval for scope increases >25%"
      },
      {
        "name": "epic_completion_approval",
        "trigger": "field_change",
        "field": "status",
        "condition": "new_value == 'complete'",
        "approvers": ["product_owner_id"],
        "requiredConditions": ["weighted_progress >= 100", "success_criteria_validated == true"],
        "description": "Product owner approval for epic completion"
      },
      {
        "name": "high_risk_escalation",
        "trigger": "computed_field_change",
        "field": "epic_health_score",
        "condition": "new_value < 60",
        "approvers": ["project.sponsor_id"],
        "description": "Executive notification for unhealthy epics"
      }
    ],
    "dependencies": [
      {
        "name": "epic_sequencing",
        "dependencyType": "finish_to_start",
        "description": "Epics can depend on completion of other epics"
      },
      {
        "name": "parallel_epic_development",
        "dependencyType": "start_to_start",
        "description": "Epics that need coordinated development"
      }
    ],
    "automations": [
      {
        "name": "auto_update_progress",
        "trigger": "related_entity_change",
        "entity": "Task",
        "action": "recalculate_computed_fields",
        "description": "Automatically update epic metrics when tasks change"
      },
      {
        "name": "completion_notification",
        "trigger": "computed_field_change",
        "field": "weighted_progress",
        "condition": "new_value >= 100 && old_value < 100",
        "action": "notify_stakeholders",
        "description": "Notify stakeholders when epic reaches 100% completion"
      }
    ]
  }
}