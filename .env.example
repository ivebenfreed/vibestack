# Environment variables for VibeStack development

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibestack_dev

# Authentication
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5173

# Bootstrap passwords (for development only)
# If not set, passwords will be auto-generated
ADMIN_PASSWORD=
TEST_USER_PASSWORD=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_TEST_PASSWORD=

# Email (for OTP)
RESEND_API_KEY=your-resend-api-key

# Environment
ENVIRONMENT=development

# Ports (defaults)
WEB_PORT=5173
SERVER_PORT=8787
DB_PORT=5432
PROXY_PORT=4444