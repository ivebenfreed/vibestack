{
  "name": "@repo/dataforge-next",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate-entities": "tsx src/scripts/generate-entities.ts",
    "generate-dexie-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-dexie-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-drizzle-schema": "tsx src/scripts/generate-drizzle-schema.ts",
    "generate-sync-metadata": "tsx src/scripts/generate-sync-metadata.ts",
    "generate-all": "npm run generate-entities && npm run generate-dexie-schema && npm run generate-dexie-services && npm run generate-drizzle-schema && npm run generate-sync-metadata",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/reflection": "^6.4.0",
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}