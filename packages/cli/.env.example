# Server API URL
API_URL=http://localhost:8787

# Bootstrap Secret for initial super admin creation
BOOTSTRAP_SECRET=your_very_secret_bootstrap_key

# Super Admin credentials for seeding
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=superadminpassword
SEED_SUPER_ADMIN_NAME="Super Admin"

# Batch user seeding configuration
SEED_BATCH_USER_COUNT=10
SEED_BATCH_USER_EMAIL_PATTERN=testuser{index}@example.com
SEED_BATCH_USER_NAME_PATTERN="Test User {index}"
SEED_BATCH_USER_PASSWORD=testpassword
SEED_BATCH_USER_ROLE=MEMBER # Corresponds to UserRole.MEMBER