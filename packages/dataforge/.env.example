# This is an example .env file for the dataforge package.
# Copy this file to .env.development, .env.preview, and .env.production
# and customize the values for each environment.
#
# The scripts will automatically load the correct .env file based on NODE_ENV.
# If NODE_ENV is not set, it defaults to 'development'.
# Variables in environment-specific files (e.g., .env.development)
# will override variables in a general .env file (if you choose to use one).

# --- Server Database Configuration ---
# Option 1: Use a single DATABASE_URL (recommended for services like Neon)
# This URL will override individual host, port, user, password, database, and ssl settings.
#
# Example for Development (local Docker Postgres or similar):
# DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/vibestack_dev
#
# Example for Preview (staging database):
# DATABASE_URL=postgresql://preview_user:preview_pass@preview.example.com:5432/vibestack_preview?sslmode=require
#
# Example for Production (production database):
# DATABASE_URL=postgresql://prod_user:prod_pass@prod.example.com:5432/vibestack_prod?sslmode=require

# Option 2: Individual database settings (used if DATABASE_URL is not provided)
# These are typically for local development if not using a DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_db_password # CHANGE THIS
DB_NAME=vibestack_dev # Suffix with _dev, _preview, _prod as appropriate
DB_SSL=false # Set to true for cloud databases that require SSL

# --- Client Database Configuration (PGlite) ---
# PGlite runs in the browser or Node.js, typically doesn't need .env configuration
# for connection details. However, you might have app-specific settings.
# Example:
# CLIENT_APP_SETTING=some_value

# --- General Settings ---
# NODE_ENV will be automatically detected (development, preview, production).
# You can set it explicitly if needed, e.g., for testing specific configurations.
# NODE_ENV=development

# Debug mode for TypeORM logging (true or false)
# This can be useful for any environment during troubleshooting.
DEBUG_ORM=false