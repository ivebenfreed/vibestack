{
  "name": "@repo/dataforge",
  "version": "0.2.0",
  "description": "Powerful data layer factory for VibeStack - forges schemas, types, migrations, and sync tools for both server and client databases",
  "type": "module",
  "exports": {
    "./client-entities": {
      "types": "./dist/client-entities.d.ts",
      "import": "./dist/client-entities.js"
    },
    "./server-entities": {
      "types": "./dist/server-entities.d.ts",
      "import": "./dist/server-entities.js"
    },
    "./column-configurations": {
      "types": "./dist/column-configurations.d.ts",
      "import": "./dist/column-configurations.js"
    },
    "./rdg-column-configurations": {
      "types": "./dist/rdg-column-configurations.d.ts",
      "import": "./dist/rdg-column-configurations.js"
    },
    "./vibegridx-columns": {
      "types": "./dist/vibegridx-columns.d.ts",
      "import": "./dist/vibegridx-columns.js"
    },
    "./*-operations": {
      "types": "./dist/*-operations.d.ts",
      "import": "./dist/*-operations.js"
    },
    "./dexie-schema": {
      "types": "./dist/dexie-schema.d.ts",
      "import": "./dist/dexie-schema.js"
    },
    "./dexie-domain-services": {
      "types": "./dist/dexie-domain-services.d.ts",
      "import": "./dist/dexie-domain-services.js"
    },
    "./dexie-domain": {
      "types": "./dist/dexie-domain/index.d.ts",
      "import": "./dist/dexie-domain/index.js"
    },
    "./dexie-domain/*": {
      "types": "./dist/dexie-domain/*.d.ts",
      "import": "./dist/dexie-domain/*.js"
    },
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.js",
      "require": "./dist/entities/*.js"
    },
    "./datasources/*": {
      "types": "./dist/datasources/*.d.ts",
      "import": "./dist/datasources/*.js",
      "require": "./dist/datasources/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-entities": "tsx src/scripts/generate-entities.ts",
    "generate-column-configs": "tsx src/scripts/generate-column-configs.ts",
    "generate-rdg-columns": "tsx src/scripts/generate-rdg-columns.ts",
    "generate-crud-operations": "tsx src/scripts/generate-crud-operations.ts",
    "generate-dexie-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-dexie-domain-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate": "pnpm run generate-entities && pnpm run generate-crud-operations && pnpm run generate-dexie-schema && pnpm run generate-dexie-domain-services",
    "compile": "tsup",
    "build": "pnpm run forge:build",
    "migration:generate:server": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:generate",
    "migration:generate:client": "tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:generate",
    "migration:run:server": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:run",
    "migration:run:client": "tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:run",
    "migration:run:server:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:run",
    "migration:run:server:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:run",
    "migration:run:server:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:run",
    "migration:run:client:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:run",
    "migration:run:client:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:run",
    "migration:run:client:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:run",
    "migration:generate:server:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:generate",
    "migration:generate:server:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:generate",
    "migration:generate:server:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:generate",
    "migration:revert:server": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:revert",
    "migration:revert:client": "tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:revert",
    "migration:revert:server:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:revert",
    "migration:revert:server:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:revert",
    "migration:revert:server:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:revert",
    "migration:show:server": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:show",
    "migration:show:client": "tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:show",
    "migration:show:server:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:show",
    "migration:show:server:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:show",
    "migration:show:server:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/server.ts migration:show",
    "migration:show:client:dev": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:show",
    "migration:show:client:staging": "NODE_ENV=preview tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:show",
    "migration:show:client:prod": "NODE_ENV=production tsx ./node_modules/typeorm/cli.js -d src/datasources/client.ts migration:show",
    "migration:run:local": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server-local.ts migration:run",
    "migration:generate:local": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server-local.ts migration:generate",
    "migration:show:local": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server-local.ts migration:show",
    "migration:revert:local": "tsx ./node_modules/typeorm/cli.js -d src/datasources/server-local.ts migration:revert",
    "migration:upload-client": "tsx src/scripts/upload-client-migrations.ts",
    "migration:clear": "tsx src/scripts/clear-migration-tables.ts",
    "migration:clear:all": "tsx src/scripts/clear-migration-tables.ts --all",
    "migration:clear:server": "tsx src/scripts/clear-migration-tables.ts --server",
    "migration:clear:published": "tsx src/scripts/clear-migration-tables.ts --published",
    "migration:clear:lite-local": "tsx src/scripts/clear-migration-tables.ts --lite-local",
    "forge:build": "pnpm run generate && pnpm run compile",
    "forge:dexie": "pnpm run generate-dexie-schema",
    "forge:migrate": "tsx src/scripts/manage-migrations.ts",
    "forge:migrate:preview": "NODE_ENV=preview tsx src/scripts/manage-migrations.ts",
    "forge:migrate:production": "NODE_ENV=production tsx src/scripts/manage-migrations.ts",
    "forge:trigger:apply": "tsx src/scripts/manage-trigger-migration.ts",
    "deploy": "pnpm run forge:build && pnpm run forge:migrate generate && pnpm run forge:migrate run",
    "test": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "seed:task-statuses": "tsx src/seeds/seed-task-statuses.ts",
    "seed:tags": "tsx src/seeds/seed-tags.ts",
    "seed:all": "pnpm run seed:task-statuses && pnpm run seed:tags",
    "debug:changes": "tsx src/scripts/debug-changes.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dexie": "^4.0.11",
    "dotenv": "^16.5.0",
    "pg": "^8.15.6",
    "reflect-metadata": "^0.1.14",
    "typeorm": "^0.3.22",
    "typeorm-pglite": "^0.3.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@microsoft/api-extractor": "^7.52.5",
    "@types/node": "^18.19.87",
    "tsup": "^8.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}