{
  "name": "@repo/dataforge",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client-entities": {
      "types": "./dist/generated/client-entities.d.ts",
      "import": "./dist/generated/client-entities.js"
    },
    "./server-entities": {
      "types": "./dist/generated/server-entities.d.ts",
      "import": "./dist/generated/server-entities.js"
    },
    "./dexie-schema": {
      "types": "./dist/generated/dexie-schema.d.ts",
      "import": "./dist/generated/dexie-schema.js"
    },
    "./drizzle-schema": {
      "types": "./dist/generated/drizzle-schema.d.ts",
      "import": "./dist/generated/drizzle-schema.js"
    },
    "./sync-metadata": {
      "types": "./dist/generated/sync-metadata.d.ts",
      "import": "./dist/generated/sync-metadata.js"
    }
  },
  "scripts": {
    "generate-entities": "tsx src/scripts/generate-entities.ts",
    "generate-dexie-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-client-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-dexie-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-client-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-drizzle-schema": "tsx src/scripts/generate-drizzle-schema.ts",
    "generate-sync-metadata": "tsx src/scripts/generate-sync-metadata.ts",
    "generate": "npm run generate-entities && npm run generate-dexie-schema && npm run generate-dexie-services && npm run generate-drizzle-schema && npm run generate-sync-metadata",
    "forge:build": "npm run generate",
    "forge:client": "npm run generate-client-schema && npm run generate-client-services",
    "type-check": "tsc --noEmit",
    "build": "npm run forge:build"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/reflection": "^6.4.0",
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}