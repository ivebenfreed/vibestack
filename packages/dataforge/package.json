{
  "name": "@repo/dataforge",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client-entities": {
      "types": "./src/generated/client-entities.ts",
      "import": "./src/generated/client-entities.ts"
    },
    "./server-entities": {
      "types": "./src/generated/server-entities.ts",
      "import": "./src/generated/server-entities.ts"
    },
    "./dexie-schema": {
      "types": "./src/generated/dexie-schema.ts",
      "import": "./src/generated/dexie-schema.ts"
    },
    "./drizzle-schema": {
      "types": "./src/generated/drizzle-schema.ts",
      "import": "./src/generated/drizzle-schema.ts"
    },
    "./sync-metadata": {
      "types": "./src/generated/sync-metadata.ts",
      "import": "./src/generated/sync-metadata.ts"
    },
    "./dexie-domain": {
      "types": "./src/generated/dexie-domain/index.ts",
      "import": "./src/generated/dexie-domain/index.ts"
    },
    "./dexie-domain/*": {
      "types": "./src/generated/dexie-domain/*.ts",
      "import": "./src/generated/dexie-domain/*.ts"
    }
  },
  "scripts": {
    "generate-entities": "tsx src/scripts/generate-entities.ts",
    "generate-dexie-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-client-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-dexie-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-client-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-drizzle-schema": "tsx src/scripts/generate-drizzle-schema.ts",
    "generate-sync-metadata": "tsx src/scripts/generate-sync-metadata.ts",
    "generate": "npm run generate-entities && npm run generate-dexie-schema && npm run generate-dexie-services && npm run generate-drizzle-schema && npm run generate-sync-metadata",
    "forge:build": "npm run generate",
    "forge:client": "npm run generate-client-schema && npm run generate-client-services",
    "type-check": "tsc --noEmit",
    "build": "npm run forge:build",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "migration:pending": "mikro-orm migration:pending",
    "migration:fresh": "mikro-orm migration:fresh",
    "schema:drop": "mikro-orm schema:drop",
    "schema:update": "mikro-orm schema:update",
    "schema:create": "mikro-orm schema:create",
    "schema:fresh": "mikro-orm schema:fresh"
  },
  "dependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/reflection": "^6.4.0",
    "dexie": "^4.0.10",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}