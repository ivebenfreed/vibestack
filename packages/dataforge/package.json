{
  "name": "@repo/dataforge",
  "version": "0.2.0",
  "description": "Powerful data layer factory for VibeStack - forges schemas, types, migrations, and sync tools for both server and client databases",
  "type": "module",
  "exports": {
    "./client-entities": {
      "types": "./dist/generated/client-entities.d.ts",
      "import": "./dist/client-entities.js"
    },
    "./server-entities": {
      "types": "./dist/generated/server-entities.d.ts",
      "import": "./dist/server-entities.js"
    },
    "./*-operations": {
      "types": "./dist/generated/*-operations.d.ts",
      "import": "./dist/*-operations.js"
    },
    "./crud-operations": {
      "types": "./dist/generated/crud-operations.d.ts",
      "import": "./dist/crud-operations.js"
    },
    "./dexie-schema": {
      "types": "./dist/generated/dexie-schema.d.ts",
      "import": "./dist/dexie-schema.js"
    },
    "./drizzle-schema": {
      "types": "./dist/generated/drizzle-schema.d.ts",
      "import": "./dist/drizzle-schema.js"
    },
    "./dexie-domain": {
      "types": "./dist/generated/dexie-domain/index.d.ts",
      "import": "./dist/dexie-domain/index.js"
    },
    "./dexie-domain/*": {
      "types": "./dist/generated/dexie-domain/*.d.ts",
      "import": "./dist/dexie-domain/*.js"
    },
    "./entities/*": {
      "types": "./dist/entities/*.d.ts",
      "import": "./dist/entities/*.js",
      "require": "./dist/entities/*.js"
    },
    "./datasources/*": {
      "types": "./dist/datasources/*.d.ts",
      "import": "./dist/datasources/*.js",
      "require": "./dist/datasources/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "require": "./dist/utils/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-entities": "tsx src/scripts/generate-entities.ts",
    "generate-crud-operations": "tsx src/scripts/generate-crud-operations.ts",
    "generate-client-schema": "tsx src/scripts/generate-dexie-schema.ts",
    "generate-client-services": "tsx src/scripts/generate-dexie-domain-services.ts",
    "generate-drizzle-schema": "tsx src/scripts/generate-drizzle-schema.ts",
    "generate": "pnpm run generate-entities && pnpm run generate-crud-operations && pnpm run generate-client-schema && pnpm run generate-client-services && pnpm run generate-drizzle-schema",
    "compile": "tsup",
    "build": "pnpm run forge:build",
    "forge:build": "pnpm run generate && pnpm run compile",
    "forge:client": "pnpm run generate-client-schema",
    "test": "vitest",
    "test:cf-worker": "tsx src/worker-test/test-cf-worker.ts",
    "dev:cf-worker": "cd src/worker-test && wrangler dev",
    "dev:cf-worker-minimal": "cd src/worker-test && wrangler dev --config wrangler-minimal.toml --port 8790",
    "deploy:cf-worker": "cd src/worker-test && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "dexie": "^4.0.11",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@microsoft/api-extractor": "^7.52.5",
    "@swc/core-linux-x64-gnu": "^1.13.3",
    "@types/node": "^18.19.87",
    "dotenv": "^16.5.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}